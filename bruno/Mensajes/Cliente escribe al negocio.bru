meta {
  name: Cliente escribe al negocio
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/mensajes/pedidos/{{msgPedidoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "texto": "Hola, ¿pueden entregar después de las 5?"
  }
}

assert {
  res.status: eq 201
  res.body.mio: eq true
  res.body.leido: eq false
}
