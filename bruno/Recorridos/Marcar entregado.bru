meta {
  name: Marcar entregado
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/pedidos/{{flujoPedidoId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenFlujo}}
}

body:json {
  {
    "estado": "ENTREGADO"
  }
}

assert {
  res.status: eq 200
  res.body.estado: eq ENTREGADO
}
