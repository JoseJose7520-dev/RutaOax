meta {
  name: Crear repartidor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/equipo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenNegocio}}
}

body:json {
  {
    "nombre": "Repartidor Prueba",
    "email": "{{emailMiembro}}",
    "password": "Equipo#2026",
    "telefono": "9515550150"
  }
}

vars:post-response {
  miembroId: res.body.id
}

script:pre-request {
  bru.setVar("emailMiembro", "miembro" + Date.now() + "@rutaoax.com");
}

assert {
  res.status: eq 201
  res.body.usuario.perfil.tipoRepartidor: eq EMPRESA
}
