meta {
  name: Login admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@rutaoax.com",
    "password": "Admin#2026"
  }
}

vars:post-response {
  tokenAdmin: res.body.token
  adminId: res.body.usuario.id
}

assert {
  res.status: eq 200
}
