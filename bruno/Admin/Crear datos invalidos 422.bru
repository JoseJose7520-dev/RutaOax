    "password": "corta",
    "telefono": "123",
    "tipo": "JEFE"
  }
}

assert {
  res.status: eq 422
  res.body.errores.email: isDefined
  res.body.errores.password: isDefined
  res.body.errores.tipo: isDefined
}
