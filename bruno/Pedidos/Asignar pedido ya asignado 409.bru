meta {
  name: Asignar pedido ya asignado 409
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/pedidos/asignar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenNegocio}}
}

body:json {
  {
    "pedidoIds": [
      "{{pedidoId}}"
    ],
    "repartidorId": "{{repartidorAsignId}}",
    "vehiculoId": "{{vehiculoCupoId}}",
    "fecha": "2030-06-15"
  }
}

assert {
  res.status: eq 409
}
