meta {
  name: Asignar con repartidor de otro negocio 404
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/pedidos/asignar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenNegocio2}}
}

body:json {
  {
    "pedidoIds": [
      "{{pedidoId}}"
    ],
    "repartidorId": "{{repartidorAsignId}}",
    "vehiculoId": "{{vehiculoCupoId}}",
    "fecha": "2030-06-15"
  }
}

assert {
  res.status: eq 404
}
