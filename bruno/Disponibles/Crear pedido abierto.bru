meta {
  name: Crear pedido abierto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pedidos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenNegocio}}
}

body:json {
  {
    "clienteNombre": "Cliente Disponible",
    "clienteTelefono": "9515550171",
    "direccion": "Calle Abierta 9",
    "zona": "Jalatlaco",
    "articulos": 1,
    "total": 120
  }
}

vars:post-response {
  dispPedidoId: res.body.id
}

assert {
  res.status: eq 201
}
